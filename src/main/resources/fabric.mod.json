{
	"schemaVersion": 1,
	"id": "modmanager",
	"version": "${version}",
	"name": "Mod Manager",
	"description": "A client-side manager for Minecraft mods and resource packs.",
	"authors": [
		"Me!"
	],
	"contact": {
		"sources": "https://github.com/youcef652/Mod-Manager"
	},
	"license": "CC0-1.0",
	"icon": "assets/modmanager/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.client.ExampleModClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}